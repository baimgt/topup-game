# ==========================================
# 🎮 GAMETOPUP - ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# 1. DATABASE (MongoDB)
# ------------------------------------------
# Sesuaikan jika menggunakan MongoDB lokal atau MongoDB Atlas (cloud)
DATABASE_URL="mongodb://localhost:27017/game_topup"
MONGODB_URI="mongodb://localhost:27017/game_topup"

# ------------------------------------------
# 2. AUTENTIKASI & KEAMANAN (JWT)
# ------------------------------------------
# String rahasia bebas untuk enkripsi token JWT login/admin
JWT_SECRET="gametopup-super-secret-key-change-this-in-production-2026"

# ------------------------------------------
# 3. URL APLIKASI
# ------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------
# 4. DIGIFLAZZ (Supplier Otomatis Topup Game)
# Dapatkan di https://digiflazz.com -> Pengaturan -> API
# ------------------------------------------
DIGIFLAZZ_USERNAME="your-digiflazz-username"
DIGIFLAZZ_API_KEY="your-digiflazz-api-key"
# Mode testing (true = transaksi tes / tidak potong saldo riil)
DIGIFLAZZ_TESTING="true"
DIGIFLAZZ_CHECK_LIVE="false"

# ------------------------------------------
# 5. MIDTRANS (Payment Gateway)
# Dapatkan di https://dashboard.midtrans.com -> Settings -> Access Keys
# ------------------------------------------
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"

# ------------------------------------------
# 6. GOOGLE AUTH (Opsional)
# Dapatkan di Google Cloud Console -> Credentials -> OAuth 2.0 Client ID
# ------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ------------------------------------------
# 7. SMTP EMAIL (Nodemailer - OTP / Notifikasi Order / Voucher)
# Gunakan Gmail App Password jika menggunakan smtp.gmail.com
# ------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"GamerStore\" <no-reply@gamerstore.com>"
